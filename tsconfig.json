{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "types": ["@adonisjs/core"],
    "baseUrl": ".", 
    "paths": {
      "#validators/*": ["app/validators/*"],
      "#models/*": ["app/models/*"],
      "#controllers/*": ["app/controllers/*"],
      "@ioc:Adonis/*": ["./node_modules/@adonisjs/*/build"]
    }
  }
}
